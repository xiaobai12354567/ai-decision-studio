# Server-only credentials. Never prefix secrets with NEXT_PUBLIC_.
# Live mode must report missing credentials instead of silently returning demo data.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Official DeepSeek endpoint. Replace with an HTTPS-compatible gateway if needed.
# Localhost HTTP is supported only for a separate integration-test model fixture.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Required for persisted decisions. No implicit JSON-file storage fallback.
# compose.database.yaml publishes PostgreSQL on host port 5433 for source development.
# Example: postgresql://decision:YOUR_PASSWORD@127.0.0.1:5433/decision
DATABASE_URL=
# Optional: only for the existing Windows + Ubuntu-22.04 WSL setup.
# Leave unset on ordinary Linux/macOS/Docker Desktop or managed-database deployments.
# DATABASE_BIND_IP=YOUR_CURRENT_WSL_IP
