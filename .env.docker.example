# Linux Docker deployment: copy this file to .env, then run:
# docker compose up -d --build --wait --wait-timeout 180
# Use a long random alphanumeric password. For example: openssl rand -hex 24
# Avoid URL-reserved characters because compose.yml builds DATABASE_URL from these values.
POSTGRES_USER=decision
POSTGRES_DB=decision
POSTGRES_PASSWORD=

# Server-only model configuration. Leave the API key empty to use manual editing only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional HTTPS-compatible gateway; empty uses the official DeepSeek endpoint.
DEEPSEEK_BASE_URL=

# Application port on 127.0.0.1 of the Docker host, for an HTTPS reverse proxy.
APP_PORT=3000
