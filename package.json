{
  "name": "nextstep-decision-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "node scripts/check-api.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:workflows": "node scripts/test-workflows.mjs",
    "test:live-ai": "node scripts/check-live-ai.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "^6.0.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
